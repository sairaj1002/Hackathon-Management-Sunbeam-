{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-1234-56789abcdef0",
		"name": "Hackathon Management API",
		"description": "Full collection for testing Spring Boot Hackathon API endpoints with JWT Auth.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080/api",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "hackathonId",
			"value": "hack-01",
			"type": "string"
		},
		{
			"key": "teamId",
			"value": "team-01",
			"type": "string"
		},
		{
			"key": "submissionId",
			"value": "sub-01",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Auth Management",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Password123!\",\n  \"displayName\": \"John Doe\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						}
					}
				},
				{
					"name": "Login (Auto Saves JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('authToken', jsonData.token);",
									"    console.log('Auth Token Set:', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"organizer@hackathon.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "2. Hackathon Management",
			"item": [
				{
					"name": "Create Hackathon",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Spring Cloud Hack 2026\",\n  \"startsAt\": \"2026-08-01T09:00:00\",\n  \"submissionDeadline\": \"2026-08-10T18:00:00\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/hackathons", "host": ["{{baseUrl}}"], "path": ["hackathons"] }
					}
				},
				{
					"name": "Get Hackathons (Page-Based)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/hackathons?page=0&size=10&sortBy=startsAt&sortDir=desc",
							"host": ["{{baseUrl}}"],
							"path": ["hackathons"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" },
								{ "key": "sortBy", "value": "startsAt" },
								{ "key": "sortDir", "value": "desc" }
							]
						}
					}
				},
				{
					"name": "Update Hackathon",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Updated Hackathon 2026\",\n  \"startsAt\": \"2026-08-01T09:00:00\",\n  \"submissionDeadline\": \"2026-08-12T23:59:59\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/hackathons/{{hackathonId}}", "host": ["{{baseUrl}}"], "path": ["hackathons", "{{hackathonId}}"] }
					}
				}
			]
		},
		{
			"name": "3. Team Management",
			"item": [
				{
					"name": "Create Team",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"hackathonId\": \"{{hackathonId}}\",\n  \"name\": \"Code Architects\",\n  \"maxSize\": 4\n}"
						},
						"url": { "raw": "{{baseUrl}}/teams", "host": ["{{baseUrl}}"], "path": ["teams"] }
					}
				},
				{
					"name": "Join Team via Invite Code",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"inviteCode\": \"BYTE2026\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/teams/join", "host": ["{{baseUrl}}"], "path": ["teams", "join"] }
					}
				}
			]
		},
		{
			"name": "4. Submissions",
			"item": [
				{
					"name": "Upsert Submission",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"repositoryUrl\": \"https://github.com/myteam/project\",\n  \"demoUrl\": \"https://demo.vercel.app\",\n  \"description\": \"Real-time collaborative workspace platform.\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/teams/{{teamId}}/submission", "host": ["{{baseUrl}}"], "path": ["teams", "{{teamId}}", "submission"] }
					}
				},
				{
					"name": "Get Submissions (Cursor-Based)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/submissions?cursor=2026-07-27T10:00:00&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["submissions"],
							"query": [
								{ "key": "cursor", "value": "2026-07-27T10:00:00" },
								{ "key": "limit", "value": "10" }
							]
						}
					}
				}
			]
		},
		{
			"name": "5. Evaluation & Leaderboard",
			"item": [
				{
					"name": "Add Criterion",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"UI/UX & Accessibility\",\n  \"weight\": 0.30\n}"
						},
						"url": { "raw": "{{baseUrl}}/hackathons/{{hackathonId}}/criteria", "host": ["{{baseUrl}}"], "path": ["hackathons", "{{hackathonId}}", "criteria"] }
					}
				},
				{
					"name": "Submit Judge Score",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"criterionId\": \"crit-01\",\n  \"score\": 9,\n  \"feedback\": \"Outstanding implementation and smooth UI workflow!\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/submissions/{{submissionId}}/scores", "host": ["{{baseUrl}}"], "path": ["submissions", "{{submissionId}}", "scores"] }
					}
				},
				{
					"name": "Get Hackathon Leaderboard",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/hackathons/{{hackathonId}}/leaderboard", "host": ["{{baseUrl}}"], "path": ["hackathons", "{{hackathonId}}", "leaderboard"] }
					}
				}
			]
		}
	]
}